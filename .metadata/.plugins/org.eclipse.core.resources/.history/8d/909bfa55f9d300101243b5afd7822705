    public void sendEmailWithAttachment(String to, String subject, String htmlBody, byte[] attachmentBytes, String attachmentName) {
        MimeMessage msg = mailSender.createMimeMessage();

        try {
            MimeMessageHelper helper = new MimeMessageHelper(msg, true, "UTF-8");
            helper.setTo(to);
            helper.setSubject(subject);
            helper.setText(htmlBody, true);

            ByteArrayDataSource dataSource = new ByteArrayDataSource(attachmentBytes, "application/pdf");
            helper.addAttachment(attachmentName, dataSource);

            mailSender.send(msg);
        } catch (MessagingException e) {
            throw new RuntimeException("Failed to send email: " + e.getMessage(), e);
        }
    }

    
    
    
