    public Booking createBooking(BookingRequest request) {

        // 1) load room
        AdminRoom room = roomRepo.findById(request.getRoomId())
                .orElseThrow(() -> new ResourceNotFoundException("Room not found"));

        // 2) load user
        User user = userRepo.findById(request.getUserId())
                .orElseThrow(() -> new ResourceNotFoundException("User not found"));
        		System.out.print("........"+request.getUserId());
        // 3) check room status
        if (room.getStatus() != RoomStatus.AVAILABLE) {
            throw new RuntimeException("Room is not available (status issue)");
        }

        // 4) overlapping bookings
        
        List<Booking> overlaps = bookingRepo.findOverlappingBookings(room.getId(), request.getCheckInDate(), request.getCheckOutDate());
        if (!overlaps.isEmpty()) {
            throw new RuntimeException("Room is already booked for selected dates");
        }

        // 5) load extra services
        List<ExtraService> chosenServices = new ArrayList<>();
        if (request.getServiceIds() != null && !request.getServiceIds().isEmpty()) {
            chosenServices = serviceRepo.findAllById(request.getServiceIds());
        }

        // 6) calculate nights
        long nights = ChronoUnit.DAYS.between(request.getCheckInDate(), request.getCheckOutDate());
        if (nights <= 0) {
            throw new RuntimeException("Check-out must be after check-in");
        }

        // 7) compute price
        double roomTotal = room.getPrice() * nights;
        double servicesTotal = chosenServices.stream().mapToDouble(s -> s.getPricePerNight() * nights).sum();
        double extraBedTotal = request.getExtraBed() * EXTRA_BED_PRICE_PER_NIGHT * nights;
        double total = roomTotal + servicesTotal + extraBedTotal;

        // 8) create booking entity
