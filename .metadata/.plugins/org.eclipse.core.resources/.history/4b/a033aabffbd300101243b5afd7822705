private BookingResponse mapToResponse(Booking booking) {
    BookingResponse response = new BookingResponse();
    response.setId(booking.getId());
    response.setCustomer(booking.getUser().getName());
    response.setPhone(booking.getUser().getContact());
    response.setEmail(booking.getUser().getEmail());
    response.setRoom(booking.getRoom().getRoomName());
    response.setCheckIn(booking.getCheckInDate());
    response.setCheckOut(booking.getCheckOutDate());
//    response.setStatus(booking.get);
    return response;
}

    
    
  

