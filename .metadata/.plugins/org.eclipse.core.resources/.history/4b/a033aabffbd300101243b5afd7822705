    public void deleteBooking(Long bookingId) {
        // 1. Find booking by ID
        Booking booking = bookingRepo.findById(bookingId)
                .orElseThrow(() -> new ResourceNotFoundException("Booking not found with ID: " + bookingId));

        // 2. Optionally, set room status back to AVAILABLE if needed
        AdminRoom room = booking.getRoom();
        if (room != null) {
            room.setStatus(RoomStatus.AVAILABLE);
            roomRepo.save(room);
        }

        // 3. Delete booking
        bookingRepo.delete(booking);
    }
    
    
    
    
    
    
    
    
    public Booking updateBooking(Long bookingId, BookingRequest request) {
        // 1️⃣ Fetch existing booking
        Booking booking = bookingRepo.findById(bookingId)
                .orElseThrow(() -> new ResourceNotFoundException("Booking not found with ID: " + bookingId));
        	
        // 2️⃣ Fetch room
        AdminRoom room = roomRepo.findById(request.getRoomId())
                .orElseThrow(() -> new ResourceNotFoundException("Room not found"));

        // 3️⃣ Fetch user
        User user = userRepo.findById(request.getUserId())
                .orElseThrow(() -> new ResourceNotFoundException("User not found"));

        // 4️⃣ Update optional user fields
        if (request.getName() != null && !request.getName().isEmpty()) user.setName(request.getName());
        if (request.getEmail() != null && !request.getEmail().isEmpty()) user.setEmail(request.getEmail());
        if (request.getContact() != null && !request.getContact().isEmpty()) user.setContact(request.getContact());
        userRepo.save(user);

        // 5️⃣ Validate dates
        if (request.getCheckInDate() == null || request.getCheckOutDate() == null) {
            throw new IllegalArgumentException("Check-in and Check-out dates are required");
        }
        long nights = ChronoUnit.DAYS.between(request.getCheckInDate(), request.getCheckOutDate());
        if (nights <= 0) {
            throw new IllegalArgumentException("Check-out must be after check-in");
        }

        // 6️⃣ Check room availability only if room or dates changed
        if (!booking.getRoom().getId().equals(room.getId()) ||
            !booking.getCheckInDate().equals(request.getCheckInDate()) ||
            !booking.getCheckOutDate().equals(request.getCheckOutDate())) {

            List<Booking> overlaps = bookingRepo.findOverlappingBookings(
                    room.getId(),
                    request.getCheckInDate(),
                    request.getCheckOutDate()
            ).stream()
             .filter(b -> !b.getId().equals(bookingId)) // ignore current booking
             .toList();

            if (!overlaps.isEmpty()) {
                throw new IllegalArgumentException(
                    "Room is already booked for selected dates. Conflicting bookings: " +
                    overlaps.stream().map(b -> b.getId().toString()).collect(Collectors.joining(", "))
                );
            }
        }

        // 7️⃣ Load extra services
        List<ExtraService> chosenServices = new ArrayList<>();
        if (request.getServiceIds() != null && !request.getServiceIds().isEmpty()) {
            chosenServices = serviceRepo.findAllById(request.getServiceIds());
            if (chosenServices.size() != request.getServiceIds().size()) {
                throw new IllegalArgumentException("Some extra services are invalid");
            }
        }

        // 8️⃣ Compute total price
        double roomTotal = room.getPrice() * nights;
        double servicesTotal = chosenServices.stream().mapToDouble(s -> s.getPricePerNight() * nights).sum();
        double extraBedTotal = request.getExtraBed() * EXTRA_BED_PRICE_PER_NIGHT * nights;
        double total = roomTotal + servicesTotal + extraBedTotal;

        // 9️⃣ Update booking fields
        booking.setRoom(room);
        booking.setCheckInDate(request.getCheckInDate());
        booking.setCheckOutDate(request.getCheckOutDate());
        booking.setAdults(request.getAdults());
        booking.setChildren(request.getChildren());
        booking.setExtraBed(request.getExtraBed());
        booking.setTotalPrice(total);

        // 1️⃣0️⃣ Update extra services safely
        booking.getExtraServices().clear();
        booking.getExtraServices().addAll(chosenServices);

        // 1️⃣1️⃣ Save and return
        try {
            return bookingRepo.save(booking);
        } catch (Exception e) {
            e.printStackTrace();
            throw new RuntimeException("Failed to update booking: " + e.getMessage());
        }
    }

    
    
